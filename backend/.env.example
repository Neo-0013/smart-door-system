# Copy this file to .env and fill in your values

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_here_change_this

# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database path
DATABASE_URL=sqlite:///./smart_door.db

# Images storage directory
IMAGES_DIR=./images

# Admin setup (first run)
ADMIN_EMAIL=joe321@gmail.com
ADMIN_PASSWORD=Password_123

# GPIO pin for door relay (Raspberry Pi 4)
DOOR_GPIO_PIN=18

# Face recognition confidence threshold (lower = stricter)
FACE_RECOGNITION_TOLERANCE=0.5
